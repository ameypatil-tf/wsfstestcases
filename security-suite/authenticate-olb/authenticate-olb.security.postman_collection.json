  "item": [
    {
      "name": "Authenticate OLB Negative Security Cases",
      "item": [
        {
          "name": "Missing client_id header",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "client_secret",
                "value": "{{WSFS_CLIENT_SECRET}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"routingNumber\": \"7688123459\",\n  \"userId\": \"username@1\",\n  \"password\": \"Password#1\",\n  \"clientId\": \"0001014726\",\n  \"channel\": \"CodeConnect\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_ENDPOINT}}/clients/v1/authenticate-online-banking",
              "host": [
                "{{BASE_ENDPOINT}}"
              ],
              "path": [
                "clients",
                "v1",
                "authenticate-online-banking"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Security negative case is rejected\", function () {",
                  "  pm.expect([400, 401, 403, 404, 422]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"No internal server error\", function () {",
                  "  pm.expect(pm.response.code).to.not.equal(500);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
